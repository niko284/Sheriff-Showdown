	end
	buffer.writeu8(SendBuffer, BLOCK_START + 5, Value.Response ~= nil and 1 or 0)
	if Value.Response ~= nil then
		table.insert(SendInstances, if Value.Response == nil then Null else Value.Response)
	end
end

