function SerdesFunctions.WriteFUNCTION_RETURN_TradingConfirmTrade(Value: { Success: boolean, Message: string?, Response: any? }, InvocationIdentifier: number): ()
	-- Allocate BLOCK: 6 bytes
	local BLOCK_START = Allocate(6)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 47)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, InvocationIdentifier)
	buffer.writeu8(SendBuffer, BLOCK_START + 2, 1)
	buffer.writeu8(SendBuffer, BLOCK_START + 3, Value.Success and 1 or 0)
	buffer.writeu8(SendBuffer, BLOCK_START + 4, Value.Message ~= nil and 1 or 0)
	if Value.Message ~= nil then
