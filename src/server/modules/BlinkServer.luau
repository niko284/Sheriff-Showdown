	ActionPayload = {
		Read = function(Buffer: buffer): (ActionPayload)
			-- Buffer overwrite
			local PreviousCursor = RecieveCursor
			local PreviousBuffer = RecieveBuffer
			local PreviousInstanceCursor = RecieveInstanceCursor
			RecieveCursor = 0
			RecieveBuffer = Buffer
			-- Read BLOCK: 9 bytes
			local BLOCK_START = Read(9)
			-- Buffer read
			local Value = {} :: any
			local Length = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
			Value.actionId = buffer.readstring(RecieveBuffer, Read(Length), Length)
			if #Value.actionId < 0 then error(`Expected length of "Value.actionId" to be larger than 0, got {#Value.actionId} instead.`) end
			if #Value.actionId > 64 then error(`Expected length of "Value.actionId" to be smaller than 64, got {#Value.actionId} instead.`) end
			Length = buffer.readu8(RecieveBuffer, BLOCK_START + 1)
			Value.action = buffer.readstring(RecieveBuffer, Read(Length), Length)
			if #Value.action < 0 then error(`Expected length of "Value.action" to be larger than 0, got {#Value.action} instead.`) end
			if #Value.action > 32 then error(`Expected length of "Value.action" to be smaller than 32, got {#Value.action} instead.`) end
			if buffer.readu8(RecieveBuffer, BLOCK_START + 2) == 1 then
				-- Read BLOCK: 12 bytes
				local BLOCK_START = Read(12)
				local X = buffer.readf32(RecieveBuffer, BLOCK_START + 0)
				local Y = buffer.readf32(RecieveBuffer, BLOCK_START + 4)
				local Z = buffer.readf32(RecieveBuffer, BLOCK_START + 8)
				Value.velocity = Vector3.new(X, Y, Z)
			end
			if buffer.readu8(RecieveBuffer, BLOCK_START + 3) == 1 then
				-- Read BLOCK: 24 bytes
				local BLOCK_START = Read(24)
				local X = buffer.readf32(RecieveBuffer, BLOCK_START + 0)
				local Y = buffer.readf32(RecieveBuffer, BLOCK_START + 4)
				local Z = buffer.readf32(RecieveBuffer, BLOCK_START + 8)
				local Position = Vector3.new(X, Y, Z)
				local rX = buffer.readf32(RecieveBuffer, BLOCK_START + 12)
				local rY = buffer.readf32(RecieveBuffer, BLOCK_START + 16)
				local rZ = buffer.readf32(RecieveBuffer, BLOCK_START + 20)
				Value.origin = CFrame.new(Position) * CFrame.fromOrientation(rX, rY, rZ)
			end
			if buffer.readu8(RecieveBuffer, BLOCK_START + 4) == 1 then
				-- Read BLOCK: 8 bytes
				local BLOCK_START = Read(8)
				Value.fromGun = buffer.readf64(RecieveBuffer, BLOCK_START + 0)
			end
			if buffer.readu8(RecieveBuffer, BLOCK_START + 5) == 1 then
				-- Read BLOCK: 8 bytes
				local BLOCK_START = Read(8)
				Value.timestamp = buffer.readf64(RecieveBuffer, BLOCK_START + 0)
			end
			if buffer.readu8(RecieveBuffer, BLOCK_START + 6) == 1 then
				-- Read BLOCK: 8 bytes
				local BLOCK_START = Read(8)
				Value.targetEntityId = buffer.readf64(RecieveBuffer, BLOCK_START + 0)
			end
			if buffer.readu8(RecieveBuffer, BLOCK_START + 7) == 1 then
				-- Read BLOCK: 8 bytes
				local BLOCK_START = Read(8)
				Value.merryGoRoundId = buffer.readf64(RecieveBuffer, BLOCK_START + 0)
			end
			if buffer.readu8(RecieveBuffer, BLOCK_START + 8) == 1 then
				-- Read BLOCK: 12 bytes
				local BLOCK_START = Read(12)
				local X = buffer.readf32(RecieveBuffer, BLOCK_START + 0)
				local Y = buffer.readf32(RecieveBuffer, BLOCK_START + 4)
				local Z = buffer.readf32(RecieveBuffer, BLOCK_START + 8)
				Value.hitPosition = Vector3.new(X, Y, Z)
			end
			-- Buffer restore
			RecieveCursor = PreviousCursor
			RecieveBuffer = PreviousBuffer
			RecieveInstanceCursor = PreviousInstanceCursor
			return Value
		end,
		Write = function(Value: ActionPayload): (buffer)
			-- Buffer overwrite
			local Previous = Save()
			Load()
			-- Allocate BLOCK: 9 bytes
			local BLOCK_START = Allocate(9)
			-- Buffer write
			local Length = #Value.actionId
			buffer.writeu8(SendBuffer, BLOCK_START + 0, Length)
			Allocate(Length)
			buffer.writestring(SendBuffer, SendOffset, Value.actionId, Length)
			local Length = #Value.action
			buffer.writeu8(SendBuffer, BLOCK_START + 1, Length)
			Allocate(Length)
			buffer.writestring(SendBuffer, SendOffset, Value.action, Length)
			buffer.writeu8(SendBuffer, BLOCK_START + 2, Value.velocity ~= nil and 1 or 0)
			if Value.velocity ~= nil then
				-- Allocate BLOCK: 12 bytes
				local BLOCK_START = Allocate(12)
				local Vector = Value.velocity
				buffer.writef32(SendBuffer, BLOCK_START + 0, Vector.X)
				buffer.writef32(SendBuffer, BLOCK_START + 4, Vector.Y)
				buffer.writef32(SendBuffer, BLOCK_START + 8, Vector.Z)
			end
			buffer.writeu8(SendBuffer, BLOCK_START + 3, Value.origin ~= nil and 1 or 0)
			if Value.origin ~= nil then
				-- Allocate BLOCK: 24 bytes
				local BLOCK_START = Allocate(24)
				local Vector = Value.origin.Position
				buffer.writef32(SendBuffer, BLOCK_START + 0, Vector.X)
				buffer.writef32(SendBuffer, BLOCK_START + 4, Vector.Y)
				buffer.writef32(SendBuffer, BLOCK_START + 8, Vector.Z)
				local rX, rY, rZ = Value.origin:ToOrientation()
				buffer.writef32(SendBuffer, BLOCK_START + 12, rX)
				buffer.writef32(SendBuffer, BLOCK_START + 16, rY)
				buffer.writef32(SendBuffer, BLOCK_START + 20, rZ)
			end
			buffer.writeu8(SendBuffer, BLOCK_START + 4, Value.fromGun ~= nil and 1 or 0)
			if Value.fromGun ~= nil then
				-- Allocate BLOCK: 8 bytes
				local BLOCK_START = Allocate(8)
				buffer.writef64(SendBuffer, BLOCK_START + 0, Value.fromGun)
			end
			buffer.writeu8(SendBuffer, BLOCK_START + 5, Value.timestamp ~= nil and 1 or 0)
			if Value.timestamp ~= nil then
				-- Allocate BLOCK: 8 bytes
				local BLOCK_START = Allocate(8)
				buffer.writef64(SendBuffer, BLOCK_START + 0, Value.timestamp)
			end
			buffer.writeu8(SendBuffer, BLOCK_START + 6, Value.targetEntityId ~= nil and 1 or 0)
			if Value.targetEntityId ~= nil then
				-- Allocate BLOCK: 8 bytes
				local BLOCK_START = Allocate(8)
				buffer.writef64(SendBuffer, BLOCK_START + 0, Value.targetEntityId)
			end
			buffer.writeu8(SendBuffer, BLOCK_START + 7, Value.merryGoRoundId ~= nil and 1 or 0)
			if Value.merryGoRoundId ~= nil then
				-- Allocate BLOCK: 8 bytes
				local BLOCK_START = Allocate(8)
				buffer.writef64(SendBuffer, BLOCK_START + 0, Value.merryGoRoundId)
			end
			buffer.writeu8(SendBuffer, BLOCK_START + 8, Value.hitPosition ~= nil and 1 or 0)
			if Value.hitPosition ~= nil then
				-- Allocate BLOCK: 12 bytes
				local BLOCK_START = Allocate(12)
				local Vector = Value.hitPosition
				buffer.writef32(SendBuffer, BLOCK_START + 0, Vector.X)
				buffer.writef32(SendBuffer, BLOCK_START + 4, Vector.Y)
				buffer.writef32(SendBuffer, BLOCK_START + 8, Vector.Z)
			end
			-- Buffer restore
			local Result = buffer.create(SendCursor)
			buffer.copy(Result, 0, SendBuffer, 0, SendCursor)
			Load(Previous)
			return Result
		end
	},
